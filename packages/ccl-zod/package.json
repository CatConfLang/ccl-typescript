{
	"name": "ccl-zod",
	"version": "0.1.0",
	"description": "Zod schema integration for CCL — extract typed objects from CCLObjects.",
	"homepage": "https://github.com/tylerbutler/ccl-typescript/tree/main/packages/ccl-zod",
	"bugs": "https://github.com/tylerbutler/ccl-typescript/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tylerbutler/ccl-typescript.git",
		"directory": "packages/ccl-zod"
	},
	"license": "MIT",
	"author": "Tyler Butler <tyler@tylerbutler.com>",
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./esm/index.d.ts",
				"default": "./esm/index.js"
			}
		}
	},
	"types": "./esm/index.d.ts",
	"files": [
		"esm"
	],
	"scripts": {
		"build:api": "api-extractor run --local",
		"build:compile": "tsc --project ./tsconfig.json",
		"check": "pnpm check:format",
		"check:format": "biome format .",
		"clean": "rimraf esm _temp *.tsbuildinfo",
		"format": "biome check . --linter-enabled=false --write",
		"lint": "biome lint .",
		"lint:fix": "biome lint . --write --unsafe",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"ccl-ts": "workspace:^",
		"true-myth": "^9.3.1"
	},
	"peerDependencies": {
		"zod": "^3.25.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.8",
		"@microsoft/api-extractor": "^7.56.0",
		"@types/node": "^20.19.25",
		"@vitest/coverage-v8": "^4.0.17",
		"rimraf": "^6.1.2",
		"typescript": "~5.9.3",
		"vitest": "^4.0.17",
		"zod": "^3.25.0"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"nx": {
		"targets": {
			"build": {
				"executor": "nx:noop"
			},
			"ci": {}
		}
	}
}
